
import json
from dataclasses import dataclass, asdict
from datetime import date
from pathlib import Path

SAVE_FILE = Path("financial_goals.json")


@dataclass
class FinancialGoal:
    name: str
    target_amount: float
    deadline: str
    current_amount: float = 0.0
    completed: bool = False

    def add_money(self, amount: float) -> bool:
        if amount <= 0:
            raise ValueError("The amount must be positive.")

        self.current_amount += amount
        if self.current_amount >= self.target_amount:
            self.current_amount = self.target_amount
            self.completed = True
            return True
        return False

    def progress(self) -> float:
        if self.target_amount <= 0:
            return 0.0
        return min(self.current_amount / self.target_amount * 100, 100)

    def is_overdue(self) -> bool:
        if self.completed:
            return False
        return date.fromisoformat(self.deadline) < date.today()


def save_goals(goals: list[FinancialGoal]) -> None:
    data = [asdict(goal) for goal in goals]

    with SAVE_FILE.open("w", encoding="utf-8") as file:
        json.dump(data, file, indent=2)


def load_goals() -> list[FinancialGoal]:
    if not SAVE_FILE.exists():
        return []

    with SAVE_FILE.open("r", encoding="utf-8") as file:
        data = json.load(file)

    return [FinancialGoal(**goal) for goal in data]


def create_goal(goals: list[FinancialGoal]) -> None:
    name = input("Goal name: ").strip()

    try:
        target_amount = float(input("Target amount: $"))
        if target_amount <= 0:
            raise ValueError
    except ValueError:
        print("Enter a valid positive amount.")
        return

    deadline = input("Deadline (YYYY-MM-DD): ").strip()

    try:
        date.fromisoformat(deadline)
    except ValueError:
        print("Enter a valid date.")
        return

    goals.append(FinancialGoal(name, target_amount, deadline))
    save_goals(goals)
    print(f"Goal '{name}' created!")


def add_money(goals: list[FinancialGoal]) -> None:
    if not goals:
        print("You have no goals yet.")
        return

    for index, goal in enumerate(goals, start=1):
        status = "Complete" if goal.completed else f"{goal.progress():.1f}%"
        print(
            f"{index}. {goal.name} — "
            f"${goal.current_amount:.2f}/${goal.target_amount:.2f} "
            f"({status})"
        )

    try:
        goal_number = int(input("Choose a goal: "))
        amount = float(input("Amount to add: $"))
        goal = goals[goal_number - 1]
    except (ValueError, IndexError):
        print("Invalid goal or amount.")
        return

    try:
        completed_now = goal.add_money(amount)
    except ValueError as error:
        print(error)
        return

    save_goals(goals)
    print(f"Added ${amount:.2f} to '{goal.name}'.")

    if completed_now:
        print("Goal completed! You earned 100 XP!")


def show_goals(goals: list[FinancialGoal]) -> None:
    if not goals:
        print("You have no goals yet.")
        return

    for goal in goals:
        status = "Completed" if goal.completed else "In progress"

        if goal.is_overdue():
            status = "Overdue"

        print(
            f"\n{goal.name}\n"
            f"  Progress: ${goal.current_amount:.2f}/${goal.target_amount:.2f}\n"
            f"  Completion: {goal.progress():.1f}%\n"
            f"  Deadline: {goal.deadline}\n"
            f"  Status: {status}"
        )


def main() -> None:
    goals = load_goals()

    while True:
        print(
            "\n=== Financial Goals Game ===\n"
            "1. Create a goal\n"
            "2. Add money\n"
            "3. View goals\n"
            "4. Exit"
        )

        choice = input("Choose an option: ").strip()

        if choice == "1":
            create_goal(goals)
        elif choice == "2":
            add_money(goals)
        elif choice == "3":
            show_goals(goals)
        elif choice == "4":
            print("Goodbye!")
            break
        else:
            print("Invalid option.")


if __name__ == "__main__":
    main()
